#!/bin/sh
set -eu

CONFIG_DIR="${FCP_MYSQL_CONFIG_DIR:-/etc/mysql/mysql.conf.d}"
OUT="${CONFIG_DIR}/91-fastcp-autotune.cnf"
BACKUP="${OUT}.last-good"
MEMINFO="${FCP_MEMINFO:-/proc/meminfo}"
CGROUP_MEMORY="${FCP_CGROUP_MEMORY_MAX:-/sys/fs/cgroup/memory.max}"

mem_kb=$(awk '/^MemTotal:/{print $2}' "${MEMINFO}")
[ -n "${mem_kb}" ] || { echo "cannot determine host memory" >&2; exit 1; }

# Respect a cgroup-v2 memory ceiling when the host is containerized.
if [ -r "${CGROUP_MEMORY}" ]; then
  cgroup=$(cat "${CGROUP_MEMORY}")
  case "${cgroup}" in
    max) ;;
    *[!0-9]*) ;;
    *)
      cgroup_kb=$((cgroup / 1024))
      [ "${cgroup_kb}" -lt "${mem_kb}" ] && mem_kb="${cgroup_kb}"
      ;;
  esac
fi

# FastCP co-locates web and database workloads. Give InnoDB 25% of memory,
# clamped to avoid starving PHP or producing an ineffective tiny cache.
pool_mb=$((mem_kb / 4096))
[ "${pool_mb}" -lt 256 ] && pool_mb=256
[ "${pool_mb}" -gt 8192 ] && pool_mb=8192

if [ "${mem_kb}" -lt 2097152 ]; then
  connections=60
  table_cache=800
  tmp_mb=32
elif [ "${mem_kb}" -lt 4194304 ]; then
  connections=100
  table_cache=1200
  tmp_mb=48
elif [ "${mem_kb}" -lt 8388608 ]; then
  connections=150
  table_cache=2000
  tmp_mb=64
else
  connections=200
  table_cache=3000
  tmp_mb=96
fi

redo_mb=$((pool_mb / 2))
[ "${redo_mb}" -lt 128 ] && redo_mb=128
[ "${redo_mb}" -gt 2048 ] && redo_mb=2048

mkdir -p "${CONFIG_DIR}"
tmp=$(mktemp "${OUT}.XXXXXX")
trap 'rm -f "${tmp}"' EXIT HUP INT TERM
cat > "${tmp}" <<EOF
# Generated by /usr/lib/fastcp/mysql-tune. Re-run explicitly after resizing.
[mysqld]
innodb_buffer_pool_size = ${pool_mb}M
innodb_redo_log_capacity = ${redo_mb}M
max_connections = ${connections}
table_open_cache = ${table_cache}
table_definition_cache = ${table_cache}
tmp_table_size = ${tmp_mb}M
max_heap_table_size = ${tmp_mb}M
thread_cache_size = 32
EOF
chmod 0644 "${tmp}"

[ ! -f "${OUT}" ] || cp -a "${OUT}" "${BACKUP}"
mv -f "${tmp}" "${OUT}"
trap - EXIT HUP INT TERM

if command -v mysqld >/dev/null 2>&1 && ! mysqld --validate-config >/dev/null 2>&1; then
  if [ -f "${BACKUP}" ]; then
    mv -f "${BACKUP}" "${OUT}"
  else
    rm -f "${OUT}"
  fi
  echo "generated MySQL configuration was rejected; restored last known good file" >&2
  exit 1
fi

printf 'FastCP MySQL profile: memory=%sKiB pool=%sMiB max_connections=%s\n' \
  "${mem_kb}" "${pool_mb}" "${connections}"
